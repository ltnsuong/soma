# Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# JWT
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRY=7d
REFRESH_TOKEN_EXPIRY=30d

# Email — uses Resend (https://resend.com), NOT nodemailer
# Get a free API key at resend.com (3,000 emails/month free)
RESEND_API_KEY=re_your_api_key_here
# Sender address — must be a verified domain in Resend, or use onboarding@resend.dev for testing
EMAIL_FROM=SOMA <hello@yourdomain.com>

# Telegram — get token from @BotFather on Telegram
# Bot username: yoursomabot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# App
APP_URL=http://localhost:8081
BACKEND_URL=http://localhost:3000
NODE_ENV=development

# Server port (Railway/Render set this automatically; default 3000 locally)
PORT=3000

# Production CORS — comma-separated origins allowed to call the API
# e.g. https://your-soma-app.vercel.app,https://soma.app
CORS_ORIGINS=
