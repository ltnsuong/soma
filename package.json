{
  "name": "soma",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~56.0.13",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~56.0.22",
    "expo-apple-authentication": "~56.0.4",
    "expo-asset": "~56.0.24",
    "expo-audio": "~56.0.13",
    "expo-auth-session": "~56.0.19",
    "expo-crypto": "~56.0.5",
    "expo-dev-client": "~56.0.27",
    "expo-device": "~56.0.4",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image-picker": "~56.0.25",
    "expo-location": "~56.0.26",
    "expo-notifications": "~56.0.25",
    "expo-status-bar": "~56.0.4",
    "expo-web-browser": "~56.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-purchases": "^10.3.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "~19.2.2",
    "dependency-cruiser": "^18.3.1",
    "eslint": "^9.39.5",
    "eslint-plugin-sonarjs": "^4.2.1",
    "knip": "^6.37.0",
    "sharp": "^0.34.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export -p web && bash scripts/postbuild-web.sh",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "deadcode": "knip",
    "cycles": "depcruise --validate .dependency-cruiser.json App.tsx index.ts src backend bot",
    "test": "vitest run",
    "verify": "node scripts/quality-gate.mjs",
    "verify:accept": "node scripts/quality-gate.mjs --accept",
    "cycles:graph": "depcruise --output-type dot App.tsx index.ts src | dot -T svg > dependency-graph.svg"
  },
  "private": true
}
